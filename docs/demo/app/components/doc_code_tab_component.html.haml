= part(:component) do
  = daisy_tabs(css: "tabs-lift tabs-sm") do |tabs|
    -# This tab is a static heading for the code block below it — there is
    -# nothing to activate, so keep it out of the keyboard tab order.
    - tabs.with_tab(css: "[--tab-bg:#282c34] text-white #{@tabs_css}", content_wrapper_css: "overflow-x-auto bg-[#282c34] border border-base-300 rounded-lg px-4 py-2", active: true, html: { tabindex: "-1" }) do |tab|
      - tab.with_title do
        .flex.gap-x-2.items-center
          %span.size-4
            = loco_icon("code-bracket", css: "size-4")
          %span.whitespace-nowrap= @title

      = part(:pre) { part(:code) { content } }
