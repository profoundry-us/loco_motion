#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'date'

def get_current_version
  root_dir = File.expand_path('..', __dir__)
  version_rb_path = File.join(root_dir, 'lib', 'loco_motion', 'version.rb')
  File.read(version_rb_path).match(/VERSION\s*=\s*["'](.+?)["']/)[1]
end

def prompt_user(message, required: true)
  loop do
    print "#{message} "
    input = $stdin.gets.strip
    return input if !required && input.empty?
    return input unless input.empty?
    puts "WARNING: This field is required. Please enter a value."
  end
end

def prompt_yes_no(message, default: 'n')
  loop do
    print "#{message} (y/N): "
    response = $stdin.gets.strip.downcase
    response = default if response.empty?
    return response if %w[y yes n no].include?(response)
    puts "WARNING: Please enter 'y' or 'n'."
  end
end

def prompt_retry_skip_abort(message)
  loop do
    print "#{message} (r)etry / (s)kip / (a)bort: "
    response = $stdin.gets.strip.downcase
    return 'retry' if %w[r retry].include?(response)
    return 'skip' if %w[s skip].include?(response)
    return 'abort' if %w[a abort].include?(response)
    puts "WARNING: Please enter 'r', 's', or 'a'."
  end
end

def check_npm_auth
  output = `npm whoami 2>&1`.strip
  if $?.success?
    puts "SUCCESS: NPM authenticated as '#{output}'"
    true
  else
    puts "WARNING: NPM auth pre-check failed (npm whoami):"
    output.each_line { |line| puts "   #{line.rstrip}" }
    puts "   Your npm login is missing or expired. Run 'npm login' in another terminal."
    puts "   Note: 'npm publish' reports a misleading E404 for scoped packages when auth fails."
    false
  end
end

def check_gh_auth
  if system('gh auth status > /dev/null 2>&1')
    puts "SUCCESS: GitHub CLI authenticated"
    true
  else
    puts "WARNING: GitHub CLI not authenticated (gh auth status failed)."
    puts "   The draft-release step and the --finish phase need it. Run 'gh auth login'."
    false
  end
end

def check_gem_auth
  # Ask RubyGems where credentials actually live: legacy setups use
  # ~/.gem/credentials, but modern ones (no ~/.gem dir) write to the XDG data
  # dir (~/.local/share/gem/credentials). Hardcoding the legacy path made this
  # pre-check report missing credentials on setups where `gem push` works.
  credentials_path = Gem.configuration.credentials_path
  if File.readable?(credentials_path)
    puts "SUCCESS: RubyGems credentials found at #{credentials_path}"
    true
  else
    puts "WARNING: RubyGems credentials not found (or not readable) at #{credentials_path}"
    puts "   Run 'gem signin' in another terminal to authenticate."
    false
  end
end

def execute_command(description, command, exit_on_failure: true)
  puts "\nEXEC: #{description}"
  puts "   Running: #{command}"

  unless system(command)
    puts "ERROR: Command failed"
    if exit_on_failure
      puts "   This step is required for the release process."
      print "   Continue anyway? (y/N): "
      response = $stdin.gets.strip.downcase
      exit unless response == 'y' || response == 'yes'
    end
    return false
  end

  puts "SUCCESS: Completed successfully"
  true
end

def check_prerequisites(dry_run: false)
  puts "CHECK: Checking release prerequisites..."
  puts

  if dry_run
    puts "DRY RUN: Running read-only prerequisite checks..."
  end

  # Track fatal prerequisite failures so every problem surfaces in one pass
  # and the script still exits non-zero at the end.
  prerequisites_ok = true

  # Check if we're on main branch (safe to run in dry run)
  current_branch = `git branch --show-current`.strip
  unless current_branch == 'main'
    puts "WARNING: You're not on the main branch (currently on: #{current_branch})"
    unless dry_run
      response = prompt_yes_no("Continue anyway?", default: 'n')
      exit unless response == 'y'
    end
  else
    puts "SUCCESS: On main branch (#{current_branch})"
  end

  # Check if there are uncommitted changes (safe to run in dry run)
  unless `git status --porcelain`.strip.empty?
    puts "WARNING: You have uncommitted changes:"
    system('git status --short')
    unless dry_run
      puts "ERROR: Please commit or stash changes before proceeding with release."
      exit 1
    end
  else
    puts "SUCCESS: No uncommitted changes"
  end

  # Check that CHANGELOG.md exists (the release wizard rewrites its
  # [Unreleased] heading later, so a missing file is a hard blocker). Flag it
  # loudly but keep running; the deferred check at the end aborts with a
  # failure code so the CHANGELOG step never reads a missing file.
  if File.exist?('CHANGELOG.md')
    puts "SUCCESS: CHANGELOG.md found"
  else
    puts
    puts "!" * 60
    puts "ERROR: CHANGELOG.md not found in the project root!"
    puts
    puts "   The release wizard finalizes the CHANGELOG by rewriting its"
    puts "   '## [Unreleased]' heading, so this file is required. Create it"
    puts "   before running the release."
    puts "!" * 60
    puts
    prerequisites_ok = false
  end

  # Check that the version sources agree before touching anything (issue #340:
  # a partial bump leaves main claiming a version it isn't). Read-only, so it
  # runs in dry-run mode too.
  puts "\nCHECK: Verifying version sources agree..."
  if system('just version-check')
    puts "SUCCESS: Version sources agree"
  else
    puts "ERROR: Version sources disagree — run bin/update_version to sync them."
    prerequisites_ok = false
  end

  # Publishing runs in CI via trusted publishing, so no registry credentials
  # are needed locally — only the GitHub CLI (draft release + --finish phase).
  # Gem/npm credentials matter only for the local-publish fallback.
  puts "\nCHECK: Checking credentials (warnings only)..."
  check_gh_auth
  puts "INFO: Registry credentials are not needed — the tag push triggers the"
  puts "   'Publish Packages' workflow, which publishes via trusted publishing."
  puts

  # Check if tests pass (skip in dry run as it runs commands)
  if dry_run
    puts "DRY RUN: Skipping test execution (would run 'just test')"
  else
    response = prompt_yes_no("Run tests to ensure everything is working?", default: 'y')
    if response == 'y'
      execute_command("Running all tests", "just test")
    end
  end

  unless prerequisites_ok
    puts "ERROR: Required prerequisites are missing — aborting release."
    exit 1
  end

  if dry_run
    puts "DRY RUN: Read-only prerequisite checks completed"
  else
    puts "SUCCESS: Prerequisites check passed"
  end
end

def update_version(dry_run: false)
  puts "\nSTEP 1: Update Version"
  puts "=" * 50

  current_version = get_current_version
  puts "   Current version: #{current_version}"

  if dry_run
    puts "DRY RUN: Checking if version update is needed..."

    # Get version from main function's parsing
    version_arg = ARGV.find { |arg| !arg.start_with?('--') && !arg.start_with?('-') }

    # Check if version is already set to what we want
    if version_arg && version_arg == current_version
      puts "SUCCESS: Version already set to #{current_version}"
      return current_version
    elsif version_arg
      puts "INFO: Would update version from #{current_version} to #{version_arg}"
      return version_arg
    else
      puts "INFO: Would prompt for new version (current: #{current_version})"
      return current_version
    end
  end

  version_arg = ARGV.find { |arg| !arg.start_with?('--') && !arg.start_with?('-') }
  new_version = version_arg || prompt_user("Enter new version (e.g., 0.5.2):")

  # Check if version is already set
  if new_version == current_version
    puts "INFO: Version #{new_version} is already set"
    response = prompt_yes_no("Continue with this version?", default: 'y')
    return new_version if response == 'y'
    new_version = prompt_user("Enter different version:")
  end

  # Update version
  execute_command("Updating version to #{new_version}", "just version-set #{new_version}")

  # Update loco container
  execute_command("Updating loco container", "just loco-version-lock")

  # Show changes
  puts "\nCHANGES: Changes made:"
  system('git diff --name-only')
  puts

  response = prompt_yes_no("Commit version changes?", default: 'y')
  if response == 'y'
    execute_command("Committing version changes", "git add . && git commit -m 'Release version #{new_version}'")
  end

  new_version
end

def update_changelog(version, dry_run: false)
  puts "\nSTEP 2: Update CHANGELOG"
  puts "=" * 50

  release_header = "## [#{version}] - #{Date.today.strftime('%Y-%m-%d')}"

  if dry_run
    puts "DRY RUN: Checking if CHANGELOG update is needed..."

    changelog_content = File.read('CHANGELOG.md')
    if changelog_content.include?("[#{version}]")
      puts "SUCCESS: CHANGELOG already has [#{version}] section"
    elsif changelog_content.include?('## [Unreleased]')
      puts "INFO: Would replace '## [Unreleased]' with '#{release_header}'"
    else
      puts "WARNING: CHANGELOG missing both [Unreleased] and [#{version}] sections"
    end
    return
  end

  changelog_content = File.read('CHANGELOG.md')

  if changelog_content.include?("[#{version}]")
    puts "INFO: CHANGELOG already has [#{version}] section, skipping update"
    return
  end

  if changelog_content.include?('## [Unreleased]')
    puts "   Replacing '## [Unreleased]' with '#{release_header}'..."
    File.write('CHANGELOG.md', changelog_content.sub('## [Unreleased]', release_header))

    puts "\nCHANGES: Resulting CHANGELOG diff:"
    system('git diff CHANGELOG.md')
    puts
  else
    puts "WARNING: CHANGELOG.md has no '## [Unreleased]' section to replace."
    response = prompt_yes_no("Open CHANGELOG.md for manual editing?", default: 'y')
    if response == 'y'
      system("#{ENV['EDITOR'] || 'nano'} CHANGELOG.md")
    end
  end

  response = prompt_yes_no("Commit CHANGELOG changes?", default: 'y')
  if response == 'y'
    execute_command("Committing CHANGELOG", "git add CHANGELOG.md && git commit -m 'docs: Finalize CHANGELOG for release v#{version}'")
  end
end

def generate_llms_docs(version, dry_run: false)
  puts "\nSTEP 2.5: Generate LLM Documentation"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Would generate llms.txt documentation"
    puts "   Running: just llm"
    return
  end

  response = prompt_yes_no("Generate llms.txt documentation?", default: 'y')
  if response == 'y'
    execute_command("Generating llms.txt", "just llm")

    response = prompt_yes_no("Commit llms.txt changes?", default: 'y')
    if response == 'y'
      # `just llm` writes the files into docs/demo/public/ (llms.txt,
      # llms-full.txt, and versioned copies). It also boots the demo
      # container, which can refresh docs/demo/Gemfile.lock, so include it.
      execute_command("Committing llms.txt", "git add docs/demo/public/llms*.txt docs/demo/Gemfile.lock && git commit -m 'docs: Update llms.txt for release v#{version}'")
    end
  else
    puts "INFO: Skipping llms.txt generation (you can run it later with 'just llm')"
  end
end

def build_packages(dry_run: false)
  puts "\nSTEP 3: Build Packages"
  puts "=" * 50

  version = get_current_version
  gem_path = "builds/rubygems/loco_motion-rails-#{version}.gem"
  npm_path = "builds/npm/profoundry-us-loco_motion-#{version}.tgz"

  if dry_run
    puts "DRY RUN: Checking if packages need to be built..."

    # Check if packages already exist
    gem_exists = File.exist?(gem_path)
    npm_exists = File.exist?(npm_path)

    if gem_exists && npm_exists
      puts "SUCCESS: Both packages already built:"
      puts "   - Ruby gem: #{gem_path}"
      puts "   - NPM package: #{npm_path}"
    elsif gem_exists
      puts "INFO: Ruby gem exists, NPM package missing:"
      puts "   - Ruby gem: #{gem_path} (exists)"
      puts "   - NPM package: #{npm_path} (would build)"
    elsif npm_exists
      puts "INFO: NPM package exists, Ruby gem missing:"
      puts "   - Ruby gem: #{gem_path} (would build)"
      puts "   - NPM package: #{npm_path} (exists)"
    else
      puts "INFO: Both packages need to be built:"
      puts "   - Ruby gem: #{gem_path} (would build)"
      puts "   - NPM package: #{npm_path} (would build)"
    end
    return
  end

  # Check if packages already exist
  gem_exists = File.exist?(gem_path)
  npm_exists = File.exist?(npm_path)

  if gem_exists && npm_exists
    puts "INFO: Both packages already exist:"
    puts "   - Ruby gem: #{gem_path}"
    puts "   - NPM package: #{npm_path}"
    response = prompt_yes_no("Rebuild packages anyway?", default: 'n')
    return if response != 'y'
  end

  # Build Ruby gem if needed
  unless gem_exists
    execute_command("Building Ruby gem", "just gem-build")
  else
    puts "INFO: Ruby gem already exists: #{gem_path}"
  end

  # Verify gem exists
  unless File.exist?(gem_path)
    puts "ERROR: Ruby gem not found at expected location: #{gem_path}"
    exit 1
  end

  # Build NPM package if needed
  unless npm_exists
    execute_command("Building NPM package", "just npm-build")
  else
    puts "INFO: NPM package already exists: #{npm_path}"
  end

  # Verify NPM package exists
  unless File.exist?(npm_path)
    puts "ERROR: NPM package not found at expected location: #{npm_path}"
    exit 1
  end

  # Smoke-test the tarball contents (issue #340: registry 0.6.0 shipped
  # without loco.css and modal_controller.js because npm drops missing
  # `files` entries silently).
  execute_command("Checking NPM package contents", "just npm-check #{npm_path}")

  puts "\nSUCCESS: Both packages built successfully!"
  response = prompt_yes_no("Continue with publishing?", default: 'y')
  exit unless response == 'y'
end

def push_to_main(dry_run: false)
  puts "\nSTEP 4: Push to Main"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Would push origin main directly (releases run from main; no PR needed)"
    return
  end

  # Releases run directly on main: the push lands the commits, so there is no
  # PR to open or merge. Refuse to run from any other branch so a feature
  # branch's commits never get pushed to main.
  current_branch = `git branch --show-current`.strip
  unless current_branch == 'main'
    puts "ERROR: Releases must be run from the 'main' branch (currently on: #{current_branch})."
    puts "   Check out main and re-run the release."
    exit 1
  end

  response = prompt_yes_no("Push release commits to main?", default: 'y')
  if response == 'y'
    execute_command("Pushing changes to origin/main", "git push origin main")
    puts "SUCCESS: Release commits pushed to main."
  end
end

def tag_release(version, dry_run: false)
  puts "\nSTEP 5: Tag Release"
  puts "=" * 50

  # Helper function to check tag existence
  def check_tag_status(version)
    # Check local tag (fast)
    local_tag_exists = system("git rev-parse --verify --quiet refs/tags/v#{version} > /dev/null 2>&1")

    # Check remote tag (only if needed, use faster method)
    remote_tag_exists = false
    if local_tag_exists
      # Faster remote check - just see if the tag exists in the remote refs
      remote_tag_exists = system("git ls-remote --exit-code origin refs/tags/v#{version} > /dev/null 2>&1")
    end

    [local_tag_exists, remote_tag_exists]
  end

  local_tag_exists, remote_tag_exists = check_tag_status(version)

  if dry_run
    puts "DRY RUN: Checking if git tag exists..."

    if local_tag_exists && remote_tag_exists
      puts "SUCCESS: Tag v#{version} exists locally and remotely"
    elsif local_tag_exists
      puts "INFO: Tag v#{version} exists locally but not remotely (would push)"
    elsif remote_tag_exists
      puts "INFO: Tag v#{version} exists remotely but not locally (would pull)"
    else
      puts "INFO: Tag v#{version} does not exist (would create and push)"
    end
    return
  end

  if local_tag_exists && remote_tag_exists
    puts "INFO: Tag v#{version} already exists locally and remotely"
    response = prompt_yes_no("Create new tag anyway?", default: 'n')
    return if response != 'y'
  elsif local_tag_exists
    puts "INFO: Tag v#{version} exists locally but not remotely"
    response = prompt_yes_no("Push existing tag to remote?", default: 'y')
    if response == 'y'
      execute_command("Pushing tag to origin", "git push origin v#{version}")
    end
    return
  elsif remote_tag_exists
    puts "INFO: Tag v#{version} exists remotely but not locally"
    response = prompt_yes_no("Pull remote tag locally?", default: 'y')
    if response == 'y'
      execute_command("Pulling remote tag", "git fetch origin tag v#{version}")
    end
    return
  end

  # Create and push new tag
  execute_command("Creating git tag", "git tag v#{version}")
  execute_command("Pushing tag to origin", "git push origin v#{version}")
end

def publish_with_retries(name, command, auth_check:, fix_hint:)
  loop do
    failure = nil

    if send(auth_check)
      if execute_command("Publishing #{name}", command, exit_on_failure: false)
        return true
      end
      puts "   #{fix_hint}"
      failure = "publish failed"
    else
      failure = "auth pre-check failed"
    end

    puts
    case prompt_retry_skip_abort("#{name}: #{failure}. Fix credentials in another terminal, then:")
    when 'retry'
      next
    when 'skip'
      puts "INFO: Skipping #{name} publishing."
      return false
    when 'abort'
      puts "WARNING: Aborting release. Resolve publishing issues and re-run bin/release."
      exit 1
    end
  end
end

def wait_for_ci_publish(version, dry_run: false)
  puts "\nSTEP 6: Wait for CI Publish"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Would wait for the 'Publish Packages' workflow triggered by"
    puts "   the v#{version} tag push, then verify both registries serve #{version}."
    return
  end

  puts "   The tag push triggered .github/workflows/publish.yml, which builds"
  puts "   and publishes both packages from the tagged commit via trusted"
  puts "   publishing — no local credentials involved."

  loop do
    status = nil
    deadline = Time.now + 900
    while Time.now < deadline
      status = `gh run list --workflow publish.yml --limit 5 --json headBranch,status,conclusion --jq '[.[] | select(.headBranch == "v#{version}")][0] | "\\(.status)/\\(.conclusion)"' 2>/dev/null`.strip
      break if status.start_with?('completed')
      print "."
      sleep 15
    end
    puts

    if status == 'completed/success'
      gem_live = system("curl -sf https://rubygems.org/api/v1/versions/loco_motion-rails.json | grep -q '\"number\":\"#{version}\"'")
      npm_live = system("npm view @profoundry-us/loco_motion@#{version} version > /dev/null 2>&1")
      if gem_live && npm_live
        puts "SUCCESS: v#{version} live on RubyGems and NPM, built from the tagged commit"
        return
      end
      puts "WARNING: Workflow succeeded but registries not confirmed yet (gem: #{gem_live}, npm: #{npm_live}) — likely propagation lag."
    else
      puts "WARNING: Publish workflow state: #{status.to_s.empty? ? 'not found — did the tag push fire it?' : status}"
      puts "   Inspect with: gh run list --workflow publish.yml"
      puts "   Re-run with:  gh workflow run publish.yml -f tag=v#{version}"
    end

    case prompt_retry_skip_abort("CI publish not verified.")
    when 'retry' then next
    when 'skip'
      response = prompt_yes_no("Fall back to publishing locally (requires credentials)?", default: 'n')
      if response == 'y'
        publish_packages
        return
      end
      puts "WARNING: Continuing without verified packages — the demo update in"
      puts "   --finish will fail if the NPM package isn't published."
      return
    when 'abort' then exit 1
    end
  end
end

def publish_packages(dry_run: false)
  puts "\nFALLBACK: Publish Packages Locally"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Skipping package publishing"
    puts "   Would run an auth pre-check before each publish:"
    puts "   - RubyGems: verify credentials at #{Gem.configuration.credentials_path} ('gem signin' to fix)"
    puts "   - NPM: run 'npm whoami' ('npm login' to fix)"
    puts "   Would publish:"
    puts "   - Ruby gem to RubyGems.org"
    puts "   - NPM package to npmjs.com"
    puts "   On a failed pre-check or publish, would prompt Retry / Skip / Abort"
    puts "   so credentials can be fixed without restarting the wizard."
    return
  end

  puts "   This step requires your credentials for both RubyGems and NPM."
  puts "   Each publish runs an auth pre-check first. If a pre-check or a"
  puts "   publish fails, you can fix your credentials in another terminal"
  puts "   and retry without restarting the wizard."
  puts

  # Publish Ruby gem
  gem_published = false
  puts "INFO: Publishing Ruby Gem to RubyGems.org..."
  response = prompt_yes_no("Continue with gem publishing?", default: 'y')
  if response == 'y'
    gem_published = publish_with_retries(
      "Ruby gem", "just gem-publish",
      auth_check: :check_gem_auth,
      fix_hint: "If this is an auth problem, run 'gem signin' in another terminal."
    )
    puts "   Verify at: https://rubygems.org/gems/loco_motion-rails" if gem_published
  end

  # Publish NPM package
  npm_published = false
  puts "\nINFO: Publishing NPM package to npmjs.com..."
  response = prompt_yes_no("Continue with NPM publishing?", default: 'y')
  if response == 'y'
    npm_published = publish_with_retries(
      "NPM package", "just npm-publish",
      auth_check: :check_npm_auth,
      fix_hint: "An E404 here usually means expired auth ('npm whoami' to check, 'npm login' to fix)."
    )
    puts "   Verify at: https://www.npmjs.com/package/@profoundry-us/loco_motion" if npm_published
  end

  unless gem_published && npm_published
    skipped = []
    skipped << "Ruby gem ('just gem-publish')" unless gem_published
    skipped << "NPM package ('just npm-publish')" unless npm_published
    puts "\nWARNING: Not published: #{skipped.join(', ')}."
    puts "   You can publish manually later with the commands above."
    response = prompt_yes_no("Continue with the rest of the release anyway?", default: 'n')
    exit 1 unless response == 'y'
  end
end

# GitHub renders @-tokens in release notes as user mentions, and the release
# page's contributor strip includes everyone mentioned — so YARD tags and npm
# scopes in PR titles (@slot, @types/node, ...) pull unrelated accounts in as
# phantom "contributors". Wrap them in code spans.
def escape_release_note_mentions(body)
  # YARD tags first: in "@part/@slot" both halves need escaping, and doing
  # tags first keeps the npm-scope pass from ever seeing them.
  yard_tags = %w[part slot loco_example param option note example return see]
  body = body.gsub(/(?<!`)(@(?:#{yard_tags.join('|')}))\b(?!`)/, '`\1`')
  body.gsub(%r{(?<!`)(@[\w-]+/[\w.-]+)(?!`)}, '`\1`')
end

def create_github_release_draft(version, dry_run: false)
  puts "\nSTEP 7: Draft GitHub Release"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Would create a DRAFT GitHub release for v#{version}"
    puts "   With auto-generated notes (mention-prone tokens escaped)."
    return
  end

  existing = `gh release view v#{version} --json isDraft --jq .isDraft 2>/dev/null`.strip
  unless existing.empty?
    puts "INFO: A release for v#{version} already exists (draft: #{existing}), skipping creation"
    return
  end

  response = prompt_yes_no("Create a draft GitHub release with auto-generated notes?", default: 'y')
  unless response == 'y'
    puts "INFO: Skipping — create it manually at:"
    puts "   https://github.com/profoundry-us/loco_motion/releases/new?tag=v#{version}"
    return
  end

  created = execute_command(
    "Creating draft release",
    "gh release create v#{version} --draft --title 'v#{version}' --generate-notes",
    exit_on_failure: false
  )
  return unless created

  # Escape mention-prone tokens in the generated notes, then hand the draft
  # to the human for review (title included — past releases add a theme).
  body = `gh release view v#{version} --json body --jq .body`
  escaped = escape_release_note_mentions(body)
  if escaped != body
    require 'tempfile'
    Tempfile.create(['relnotes', '.md']) do |f|
      f.write(escaped)
      f.flush
      execute_command("Escaping mention tokens in notes", "gh release edit v#{version} --notes-file #{f.path}", exit_on_failure: false)
    end
  end

  url = `gh release view v#{version} --json url --jq .url`.strip
  puts "SUCCESS: Draft release created: #{url}"
end

def check_release_published(version, dry_run: false)
  puts "\nFINISH STEP 1: Verify GitHub Release Is Published"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Would verify the v#{version} GitHub release exists and is not a draft"
    return
  end

  loop do
    is_draft = `gh release view v#{version} --json isDraft --jq .isDraft 2>/dev/null`.strip

    if is_draft == 'false'
      puts "SUCCESS: Release v#{version} is published"
      return
    elsif is_draft == 'true'
      puts "WARNING: Release v#{version} is still a DRAFT."
      puts "   Publishing it is what triggers the YARD docs deployment."
    else
      puts "WARNING: No GitHub release found for v#{version}."
      puts "   Run phase 1 (bin/release #{version}) or create it manually."
    end

    case prompt_retry_skip_abort("Publish the release in the browser, then:")
    when 'retry' then next
    when 'skip'
      puts "WARNING: Skipping — API docs for v#{version} will NOT be deployed,"
      puts "   and the demo's API-docs links will 404."
      return
    when 'abort'
      puts "INFO: Re-run 'bin/release --finish' after publishing the release."
      exit 1
    end
  end
end

def wait_for_docs_deploy(version, dry_run: false)
  puts "\nFINISH STEP 2: Wait for API Docs Deployment"
  puts "=" * 50

  docs_host = ENV.fetch('LOCO_DOCS_HOST', 'https://loco-motion-docs.profoundry.us')
  docs_url = "#{docs_host}/v#{version}/"

  if dry_run
    puts "DRY RUN: Would wait for the 'Publish Yard Docs' workflow, then poll #{docs_url}"
    return
  end

  puts "   The demo site links its API docs to #{docs_url},"
  puts "   so it must be live before the demo deploys."

  require 'net/http'
  loop do
    # Give the release-published trigger a moment, then watch the workflow.
    deadline = Time.now + 600
    status = nil
    while Time.now < deadline
      status = `gh run list --workflow docs-yard.yml --limit 1 --json status,conclusion --jq '.[0] | "\\(.status)/\\(.conclusion)"' 2>/dev/null`.strip
      break if status.start_with?('completed')
      print "."
      sleep 15
    end
    puts

    if status == 'completed/success'
      # Workflow green — confirm the pages actually serve.
      code = Net::HTTP.get_response(URI(docs_url)).code rescue 'ERR'
      if code == '200'
        puts "SUCCESS: API docs live at #{docs_url}"
        return
      end
      puts "WARNING: Docs workflow succeeded but #{docs_url} returned #{code} (CDN lag?)."
    else
      puts "WARNING: Docs workflow state: #{status || 'unknown'} (see gh run list --workflow docs-yard.yml)"
    end

    case prompt_retry_skip_abort("Docs not verified.")
    when 'retry' then next
    when 'skip'
      puts "WARNING: Continuing without verified API docs."
      return
    when 'abort' then exit 1
    end
  end
end

def update_demo_app(dry_run: false)
  puts "\nFINISH STEP 3: Update Demo App"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Skipping demo app update"
    puts "   Would run: bin/update_demo_after_release"
    return
  end

  puts "   This will run the post-release script to update the demo app."
  response = prompt_yes_no("Continue with demo app update?", default: 'y')

  if response == 'y'
    execute_command("Updating demo app", "bin/update_demo_after_release")
  end
end

def update_stable_branch(version, dry_run: false)
  puts "\nFINISH STEP 4: Advance Stable Deploy Branch"
  puts "=" * 50

  # The demo sites (staging + production promote) deploy from `stable`, not
  # main: main carries a pre-release version between releases, so building it
  # would publish docs that claim an unreleased version, link to llms files
  # that don't exist, and index Algolia under the pre version. `stable` only
  # ever points at release commits; advance it to the demo-update commit we
  # just pushed.
  if dry_run
    puts "DRY RUN: Would advance origin/stable to the current release commit"
    puts "   Running: git push origin HEAD:stable"
    return
  end

  puts "   Heroku staging auto-deploys `stable`; advancing it ships v#{version}"
  puts "   to the public docs sites (promote staging to production after)."
  response = prompt_yes_no("Advance origin/stable to this release?", default: 'y')
  unless response == 'y'
    puts "WARNING: The deployed demo sites will stay on the previous release"
    puts "   until you push: git push origin <release-sha>:stable"
    return
  end

  # A release always fast-forwards stable (it lives in main's history). If
  # this fails, stable has diverged — inspect before forcing anything.
  execute_command("Advancing stable to v#{version}", "git push origin HEAD:stable")
end

def bump_to_next_pre_release(version, dry_run: false)
  puts "\nFINISH STEP 5: Bump Main to Next Pre-Release"
  puts "=" * 50

  # After tagging, main must stop claiming the released version — otherwise
  # every post-release commit self-identifies as v#{version} and the version
  # number no longer names a single commit (issue #340). Convention: the next
  # minor as a gem-style pre-release (cf. Rails main reporting 8.1.0.alpha).
  base = version[/\A\d+\.\d+\.\d+/]
  major, minor, = base.split('.').map(&:to_i)
  next_pre = "#{major}.#{minor + 1}.0.pre"

  if dry_run
    puts "DRY RUN: Would bump main from #{version} to #{next_pre}"
    puts "   Running: just version-set #{next_pre}, then commit and push to main"
    return
  end

  if get_current_version == next_pre
    puts "INFO: Main is already at #{next_pre}, skipping"
    return
  end

  puts "   Main currently reports #{get_current_version}; bumping to #{next_pre}"
  puts "   keeps released version numbers pointing at exactly one tagged commit."
  response = prompt_yes_no("Bump main to #{next_pre}?", default: 'y')
  unless response == 'y'
    puts "WARNING: Main still reports v#{version} — post-release commits will"
    puts "   masquerade as the release. Bump manually with:"
    puts "   just version-set #{next_pre}"
    return
  end

  execute_command("Bumping version to #{next_pre}", "just version-set #{next_pre}")
  execute_command("Updating loco container", "just loco-version-lock")

  # The demo app consumes the gem via path, so its frozen lockfile embeds the
  # gem's version — regenerate it or CI's demo job fails on the stale stamp.
  # (Deliberately NOT `just demo-version-lock`: that also upgrades the npm
  # package, which must stay at the just-published release.)
  execute_command("Syncing demo lockfile", "docker compose exec -T demo bundle install --quiet")

  puts "\nCHANGES: Changes made:"
  system('git diff --name-only')
  puts

  response = prompt_yes_no("Commit and push the pre-release bump?", default: 'y')
  if response == 'y'
    execute_command(
      "Committing pre-release bump",
      "git add . && git commit -m 'chore: Bump main to #{next_pre} after v#{version} release'"
    )
    execute_command("Pushing to origin/main", "git push origin main")
  end
end

STAGING_URL = "https://loco-motion-demo-staging.profoundry.us"
PRODUCTION_URL = "https://loco-motion.profoundry.us"

# Opens a URL in the user's default browser (macOS `open`, Linux `xdg-open`).
def open_in_browser(url)
  cmd = RUBY_PLATFORM.include?("darwin") ? "open" : "xdg-open"
  system(cmd, url) || puts("WARNING: Could not open browser — visit #{url} yourself.")
end

# Polls a site until its rendered homepage reports the released version (the
# header badge renders "vX.Y.Z"), then offers to open it for eyeball review.
def verify_site(label, step, url, version, dry_run: false)
  puts "\nFINISH STEP #{step}: Verify #{label}"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Would poll #{url} until it serves v#{version},"
    puts "   then offer to open it in your browser."
    return true
  end

  require 'net/http'
  puts "   Waiting for #{url} to serve v#{version} (deploys take a few minutes)..."

  loop do
    deadline = Time.now + 900
    found = false
    while Time.now < deadline
      body = Net::HTTP.get(URI(url)) rescue ""
      if body.match?(/v#{Regexp.escape(version)}(?![\w.])/)
        found = true
        break
      end
      print "."
      sleep 20
    end
    puts

    if found
      puts "SUCCESS: #{label} is serving v#{version}"
      response = prompt_yes_no("Open #{label.downcase} in your browser to review?", default: 'y')
      open_in_browser(url) if response == 'y'
      return true
    end

    puts "WARNING: #{label} still isn't serving v#{version} after 15 minutes."
    puts "   Check the deploy in the Heroku dashboard."
    case prompt_retry_skip_abort("#{label} not verified.")
    when 'retry' then next
    when 'skip' then return false
    when 'abort' then exit 1
    end
  end
end

def promote_to_production(dry_run: false)
  puts "\nFINISH STEP 7: Promote to Production"
  puts "=" * 50

  if dry_run
    puts "DRY RUN: Would run: heroku pipelines:promote -a loco-motion-demo-staging"
    return true
  end

  response = prompt_yes_no("Promote staging to production?", default: 'y')
  unless response == 'y'
    puts "INFO: Skipping — promote later with:"
    puts "   heroku pipelines:promote -a loco-motion-demo-staging"
    return false
  end

  execute_command(
    "Promoting staging to production",
    "heroku pipelines:promote -a loco-motion-demo-staging",
    exit_on_failure: false
  )
end

def main
  puts "RELEASE: LocoMotion Release Wizard"
  puts "=" * 50
  puts "   This wizard will walk you through the complete release process."
  puts

  # Parse arguments
  dry_run = ARGV.include?('--dry-run')

  # Show help if requested
  if ARGV.include?('--help') || ARGV.include?('-h')
    puts <<~HELP
      Usage: bin/release [VERSION] [OPTIONS]
             bin/release --finish [VERSION] [OPTIONS]

      The release runs in two phases with a human review gate between them.

      PHASE 1 — publish the artifacts (bin/release VERSION):
      1. Check prerequisites (tests, version sync, credentials)
      2. Update version
      3. Update CHANGELOG
      4. Generate llms.txt docs
      5. Build packages (with an NPM package content check)
      6. Push to main
      7. Tag release (the tag push triggers the CI publish workflow)
      8. Wait for CI to publish to RubyGems + NPM and verify both registries
         (trusted publishing — no local credentials; local publish is a fallback)
      9. Create a DRAFT GitHub release with auto-generated notes

      ...then STOP. Review and publish the GitHub release in the browser —
      publishing is what triggers the API docs deployment.

      PHASE 2 — ship the sites (bin/release --finish):
      1. Verify the GitHub release is published (not a draft)
      2. Wait for the API docs workflow and verify the docs URL serves
      3. Update demo app
      4. Advance the `stable` deploy branch (staging deploys from it)
      5. Bump main to the next pre-release (e.g. 0.8.0.pre)
      6. Wait for staging to serve the release; open it for review
      7. Promote staging to production (prompted)
      8. Wait for production to serve the release; open it for review

      Options:
        VERSION        Optional: Skip version prompt and use this version
                       (--finish infers it from version.rb when omitted)
        --finish       Run phase 2 (after the GitHub release is published)
        --dry-run      Run in dry run mode (skips git state checks and actual commands)
        --help         Show this help message

      Dry Run Mode:
        - Skips git state checks (main branch, uncommitted changes)
        - Shows what would be done without executing commands
        - Useful for testing the release workflow

      Prerequisites:
        - Clean git state (unless in dry run mode)
        - RubyGems.org credentials
        - NPM credentials
        - GitHub access for creating releases
    HELP
    exit 0
  end

  if dry_run
    puts "DRY RUN: No actual commands will be executed"
    puts
  end

  finish = ARGV.include?('--finish')

  begin
    if finish
      # PHASE 2 — ship the sites. Runs after the human has reviewed and
      # published the GitHub release. The pre-bump hasn't happened yet, so
      # version.rb still holds the released version when no arg is given.
      version_arg = ARGV.find { |arg| !arg.start_with?('-') }
      version = version_arg || get_current_version

      if version.match?(/[a-z]/i)
        puts "ERROR: Current version #{version} is a pre-release — this release"
        puts "   was already finished. Pass the version explicitly to re-run."
        exit 1
      end

      puts "FINISH: Shipping the sites for v#{version}"
      puts

      check_release_published(version, dry_run: dry_run)
      wait_for_docs_deploy(version, dry_run: dry_run)
      update_demo_app(dry_run: dry_run)
      update_stable_branch(version, dry_run: dry_run)
      bump_to_next_pre_release(version, dry_run: dry_run)
      staging_ok = verify_site("Staging", 6, STAGING_URL, version, dry_run: dry_run)

      promote = staging_ok ||
                prompt_yes_no("Staging unverified — promote anyway?", default: 'n') == 'y'
      promoted = promote && promote_to_production(dry_run: dry_run)

      verify_site("Production", 8, PRODUCTION_URL, version, dry_run: dry_run) if promoted

      if dry_run
        puts "\nDRY RUN COMPLETED (finish phase)"
      else
        puts "\nSUCCESS: Release v#{version} is fully shipped and live!"
        puts "=" * 50
        puts "   Optional follow-ups:"
        puts "   1. Reindex your local dev Algolia: just algolia-index"
        puts "   2. Close out any release-blocking issues"
      end
    else
      # PHASE 1 — publish the artifacts. Stops before anything user-facing
      # goes live so the release notes and the app get a human review.
      check_prerequisites(dry_run: dry_run)

      version = update_version(dry_run: dry_run)
      update_changelog(version, dry_run: dry_run)
      generate_llms_docs(version, dry_run: dry_run)
      build_packages(dry_run: dry_run)
      push_to_main(dry_run: dry_run)
      tag_release(version, dry_run: dry_run)
      wait_for_ci_publish(version, dry_run: dry_run)
      create_github_release_draft(version, dry_run: dry_run)

      if dry_run
        puts "\nDRY RUN COMPLETED (publish phase)"
        puts "   No actual changes were made."
        puts "   Run without --dry-run to execute the release."
      else
        puts "\nSUCCESS: Packages for v#{version} are published!"
        puts "=" * 50
        puts "   Nothing user-facing is live yet. When you're ready:"
        puts "   1. Review + publish the draft GitHub release (this deploys the API docs):"
        puts "      #{`gh release view v#{version} --json url --jq .url 2>/dev/null`.strip}"
        puts "   2. Then ship the sites:"
        puts "      bin/release --finish"
      end
    end

  rescue Interrupt
    puts "\n\nWARNING: Release process interrupted by user"
    exit 1
  rescue => e
    puts "\nERROR: #{e.message}"
    exit 1
  end
end

main
